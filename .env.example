# Copie para .env antes de subir o compose:  cp .env.example .env
# O arquivo .env nao e versionado (ver .gitignore).

# ---------- PostgreSQL ----------
POSTGRES_DB=chamados
POSTGRES_USER=chamados
POSTGRES_PASSWORD=chamados_dev_senha
POSTGRES_PORT=5432

# ---------- Adminer (profile tools) ----------
ADMINER_PORT=8080

# ---------- API (profile full) ----------
API_PORT=8081
ASPNETCORE_ENVIRONMENT=Development

# Cadeia de conexao usada pela API quando ela roda em container (profile full).
# Rodando a API na maquina (dotnet run), o appsettings.Development.json ja aponta
# para localhost e este valor nao e usado.
ConnectionStrings__Postgres=Host=postgres;Port=5432;Database=chamados;Username=chamados;Password=chamados_dev_senha

# ---------- JWT ----------
# Em producao, troque por um segredo forte e mantenha fora do versionamento.
Jwt__Emissor=ChamadosManutencao
Jwt__Audiencia=ChamadosManutencao.Api
Jwt__ChaveSecreta=chave-de-desenvolvimento-com-pelo-menos-32-bytes-troque-isto
Jwt__MinutosDeValidade=60

# ---------- Administrador inicial (comando criar-admin) ----------
ADMIN_INICIAL_EMAIL=admin@chamados.local
ADMIN_INICIAL_SENHA=Admin@2026
ADMIN_INICIAL_CPF=00000000191
ADMIN_INICIAL_NOME=Administrador Inicial
ADMIN_INICIAL_MATRICULA=ADM-000001
